<%- include('includes/header') %>
<title>Sign-Up</title>
<%- include('includes/header2') %>

    <main class="sign-up">
        <form action="/create" class="sign-up-form" method="post">
            <h2 class="title">Sign up</h2>

            <div class="input-field">
                <i class="fas fa-user"></i>
                <input type="text" placeholder="Username" name="username" required>
            </div>

            <div class="input-field">
                <i class="fas fa-envelope"></i>
                <input type="email" placeholder="Email" name="email" required>
            </div>

            <div class="input-field">
                <i class="fas fa-lock"></i>
                <input type="password" placeholder="Password" name="password" required>
            </div>

            <div class="hidden-toggles">

                <label for="isFreelancer">Freelancer</label>
                <span>
                    <input class="radio-btn" type="radio" name="isFreelancer" value="true">
                </span>
                <label>Client</label>
                <span>
                    <input class="radio-btn" type="radio" name="isFreelancer" value="false"> 
                </span>
            </div>

            <input type="submit" class="btn" value="Sign up" />

            <p class="social-text">Or Sign up with social platforms</p>

            <div class="social-media">
                <a href="#" class="social-icon">
                    <i class="fab fa-facebook-f"></i>
                </a>

                <a href="#" class="social-icon">
                    <i class="fab fa-twitter"></i>
                </a>

                <a href="#" class="social-icon">
                    <i class="fab fa-google"></i>
                </a>

                <a href="#" class="social-icon">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>

            <p>Already have an account? <a href="/signin">Sign-In.</a></p>
        </form>
    </main>
    <script src="/javascripts/index.js"></script>
</body>

</html>