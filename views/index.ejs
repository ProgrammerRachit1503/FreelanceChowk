<%- include('includes/header') %>
<title>FreelanceChowk</title>
<%- include('includes/header2') %>

    <main class="main" id="main">
        <div class="headline">
            <h1 class="post">
                Post a Job TodayFind <span class="free">Freelancers</span>
            </h1>

            <h3 class="tap">
                Tap into a global talent pool while still finding freelancers who understand your market. Whether local
                or international, our freelancers are ready to deliver results.
            </h3>

            <div class="btt">
                <input type="button" value="Start Hiring" class="bt1">
                <button class="bt2">
                    Get Hired
                </button>
            </div>
        </div>

        <img class="mainimg" src="images/mainimg.avif" alt="">
    </main>

    <div class="headline2">
        Connecting
        <span class="free"> Businesses </span>
        with top-tier
        <span class="free">Freelancers</span>
        across the globe. Whether you need a quick fix or a long-term
        <span class="free"> Partnership </span>
        , we've got the experts to bring your vision to life. Explore some of the exciting projects completed through
        our
        <span class="free"> Platform </span>.
    </div>

    <div class="jobs-section">
        <h2>Available Jobs</h2>
        <div class="jobs-list">
            <% jobs.forEach(function(job) { %>
                <div class="job-card">
                    <h3><%= job.title %></h3>
                    <p><%= job.description %></p>
                    <p><strong>Category:</strong> <%= job.category %></p>
                    <p><strong>Budget:</strong> $<%= job.budget %></p>
                    <a href="/jobs/<%= job.id %>" class="btn btn-primary">View Details</a>
                </div>
            <% }); %>
        </div>
    </div>

    <!-- <div class="img-container">
        <img src="images/pngwing-3.png" alt="image-1" class="logo-3">
        <img src="images/pngwing-1.png" alt="image-1" class="logo-1">
